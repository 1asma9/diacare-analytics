# DiaCare Analytics — Environment Variables
# Copy this file to .env (never commit .env to git)

# Optional: free openFDA API key from https://open.fda.gov/apis/authentication/
# Without a key: 1,000 requests/day per IP (240 req/min).
# With a key:  120,000 requests/day per key (240 req/min).
OPENFDA_API_KEY=

# Flask secret key (change in production)
SECRET_KEY=diacare-analytics-secret-key-2026
